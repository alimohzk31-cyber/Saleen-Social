{
	"appId": "com.saleen.service",
	"appName": "Saleen Service — سالين سيرفس",
	"webDir": "dist",
	"android": {
		"allowMixedContent": false
	},
	"server": {
		"androidScheme": "https"
	},
	"plugins": {
